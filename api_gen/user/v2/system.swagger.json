  "paths": {
    "/v2/system/apps": {
      "get": {
        "summary": "ListApps 拿产品列表 (总览图标)",
        "operationId": "SystemV2_ListApps",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2ListAppsReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "groupId",
            "description": "当前用户所在企业 id",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "type",
            "description": "app 类型: platform=平台, link=链接; 不传=不限",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "SystemV2"
        ]
      },
      "post": {
        "summary": "CreateApp 超管创建产品",
        "operationId": "SystemV2_CreateApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2CreateAppReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2CreateAppRequest"
            }
          }
        ],
        "tags": [
          "SystemV2"
        ]
      }
    },
    "/v2/system/apps/page": {
      "get": {
        "summary": "ListAppsByPage 分页查询产品列表 (管理端)",
        "operationId": "SystemV2_ListAppsByPage",
