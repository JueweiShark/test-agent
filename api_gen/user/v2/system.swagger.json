            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "name",
            "description": "显示名 (模糊匹配)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "code",
            "description": "app 编号 (模糊匹配)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "description": "1=显示 0=隐藏, 0=不限",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "type",
            "description": "app 类型: platform=平台, link=链接; 不传=不限",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "SystemV2"
        ]
      }
    },
