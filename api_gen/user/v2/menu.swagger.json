{
  "swagger": "2.0",
  "info": {
    "title": "user/v2/menu.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "MenuV2"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v2/menu": {
      "get": {
        "summary": "ListMenus 按 app 查菜单树",
        "operationId": "MenuV2_ListMenus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2ListMenusReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "description": "按平台过滤",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "dependenceParents",
            "description": "按父节点过滤,不传=全部",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "menuType",
            "description": "按菜单类型过滤",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "groupId",
            "description": "可选: 传入则只返回该企业 scope 内的菜单",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "MenuV2"
        ]
      }
    },
    "/v2/menu/tree": {
      "get": {
        "summary": "GetMenuTree 拿完整树结构 (按 app)",
        "operationId": "MenuV2_GetMenuTree",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2GetMenuTreeReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "groupId",
            "description": "可选: 传入则只返回该企业 scope 内的菜单",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "hidden",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "MenuV2"
        ]
      }
    },
    "/v2/menu/{id}": {
      "put": {
        "summary": "UpdateMenu 编辑菜单",
        "operationId": "MenuV2_UpdateMenu",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2UpdateMenuReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MenuV2UpdateMenuBody"
            }
          }
        ],
        "tags": [
          "MenuV2"
        ]
      }
    }
  },
