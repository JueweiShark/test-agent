{
  "swagger": "2.0",
  "info": {
    "title": "user/v2/auth.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AuthV2"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v2/auth/groupToken": {
      "post": {
        "summary": "IssueGroupToken 校验基础 token 并换发携带 groupId 的组 token (数据隔离改造: groupId 入 Token)",
        "operationId": "AuthV2_IssueGroupToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2IssueGroupTokenReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2IssueGroupTokenRequest"
            }
          }
        ],
        "tags": [
          "AuthV2"
        ]
      }
    },
    "/v2/auth/login": {
      "post": {
        "summary": "LoginV2 登录,返回token+用户关联的企业列表+按角色过滤后的权限信息",
        "operationId": "AuthV2_LoginV2",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2LoginV2Reply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2LoginV2Request"
            }
          }
        ],
        "tags": [
          "AuthV2"
        ]
      }
    },
    "/v2/auth/my/apps": {
      "get": {
        "summary": "ListMyApps 总览页查当前企业下我能进的平台",
        "operationId": "AuthV2_ListMyApps",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2ListMyAppsReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "groupId",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "type",
            "description": "app 类型: platform=平台, link=链接; 不传=不限",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AuthV2"
        ]
      }
    },
    "/v2/auth/userInfo": {
      "post": {
        "summary": "查询当前用户信息",
        "operationId": "AuthV2_GetUserInfo",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2GetUserInfoReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2GetUserInfoRequest"
            }
          }
        ],
        "tags": [
          "AuthV2"
        ]
      }
    }
  },
