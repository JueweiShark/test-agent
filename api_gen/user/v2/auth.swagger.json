    "v2IssueGroupTokenRequest": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "groupId": {
          "type": "string",
          "format": "int64",
          "title": "目标企业 id; 超管可传 0 (签发全局 token)"
        }
      },
      "title": "IssueGroupTokenRequest 换发组 token 请求\ntoken 为第一步 LoginV2 返回的基础 token, 服务端解析出 userId, 不信任前端直接传 userId"
    },
