            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "username",
            "description": "用户名 (模糊)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "nickname",
            "description": "姓名 (模糊)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "groupName",
            "description": "关联企业名称 (模糊)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "description": "状态 (0=禁用 1=启用, 0=不限状态 — 注: proto3 默认值无法区分\"不限\"与\"禁用\", 故\u003c=0 视为不限)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "RoleV2"
        ]
      }
    },
