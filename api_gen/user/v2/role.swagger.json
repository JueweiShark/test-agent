          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2ListRolesByGroupReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "groupId",
            "description": "企业ID (精准匹配, 0=不限企业)",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "name",
            "description": "角色名称 (模糊匹配)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "groupName",
            "description": "企业名称 (模糊匹配)",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "RoleV2"
        ]
      },
      "post": {
        "summary": "CreateRole 超管为指定企业建角色",
        "operationId": "RoleV2_CreateRole",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2CreateRoleV2Reply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2CreateRoleV2Request"
            }
          }
        ],
        "tags": [
          "RoleV2"
        ]
      }
    },
    "/v2/role/user": {
      "get": {
        "summary": "ListUserRolesByGroup 用户在某企业的角色",
